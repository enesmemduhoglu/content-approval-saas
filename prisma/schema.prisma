generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migration'lar pooled (pgbouncer) bağlantı üzerinden güvenilir çalışmaz —
  // CLI komutları (migrate/db push) bu doğrudan bağlantıyı kullanır.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Agency {
  id String @id @default(cuid())

  /**
   * Ajansın BİLDİRİM adresi — kimlik değil. F6 öncesinde `@unique` idi çünkü
   * "bir Google hesabı = bir ajans" varsayımı geçerliydi. Artık kimliği
   * `AgencyMember` taşıyor ve iki ayrı ajansın aynı iletişim adresini
   * kullanması meşru bir durum (ör. aynı kişi hem kendi ajansını açtı hem
   * başka bir ajansa davet edildi, ya da bir ajans kapanıp yenisi açıldı).
   * `@unique` bırakılsaydı bu senaryolarda GİRİŞ ANINDA unique ihlali fırlar,
   * yani kullanıcı panele hiç giremezdi. Bu yüzden kısıt kaldırıldı; kolon ve
   * içindeki veri olduğu gibi duruyor (ajans bildirimleri buradan gidiyor).
   */
  email String

  name String?

  /**
   * @deprecated F6 — ARTIK OKUNMUYOR, ARTIK YAZILMIYOR.
   *
   * Üyelik çözümü `AgencyMember.googleId` üzerinden yapılıyor. Bu kolon
   * SİLİNMEDİ çünkü (a) migration ile veri `AgencyMember`'a kopyalandı ve
   * kaynağı yok etmek geri dönüşü olmayan bir kayıp olurdu — deploy'dan sonra
   * bir sorun çıkarsa hangi ajansın hangi Google hesabına ait olduğunu
   * yalnızca bu kolon söyleyebilir; (b) kolonu düşürmek eski deployment'lar
   * (rollback) için kırıcıdır.
   *
   * NULLABLE yapıldı: yeni ajanslar bu alanı doldurmuyor. Doldurmaya devam
   * etseydik gerçek bir çakışma riski vardı — iki owner'lı bir ajanstan
   * çıkarılan kurucu tekrar giriş yaptığında kendisine yeni bir ajans
   * açılıyor, ama eski ajansın satırında hâlâ ONUN googleId'si duruyor:
   * `@unique` ihlali ve giriş sırasında patlayan bir hata. `@unique` yine de
   * duruyor; Postgres'te birden çok NULL serbest olduğu için yeni kayıtları
   * engellemez, eski verinin bütünlüğünü ise korur.
   */
  googleId String? @unique

  logoUrl    String?
  brandColor String? // "#rrggbb" — onay sayfası ve e-postada accent olarak kullanılır
  createdAt  DateTime @default(now())
  clients    Client[]
  posts      Post[]
  members    AgencyMember[]
  invites    AgencyInvite[]
}

enum AgencyRole {
  /** Davet edebilir, üye çıkarabilir. Her ajansta EN AZ BİR tane olmak zorunda. */
  owner
  /** Post/müşteri işlerinin tamamını yapar, ekip yönetimine dokunamaz. */
  member
}

/**
 * F6 — ajansta çalışan kişi. `Agency.googleId`'nin yerini alan kimlik tablosu.
 *
 * ─── Neden `session.agencyId` sözleşmesi DEĞİŞMEDİ ─────────────────────────
 * Depoda 78 yerde `agencyId` kullanılıyor ve IDOR koruması tamamen
 * `getScopedDb(session)` kuralına dayanıyor. Üyeliği aşağı akışa taşımak
 * (ör. `session.memberId` + her sorguda üyelik join'i) o 78 çağrı yerinin
 * hepsini dolaylamak demekti; her dolaylama kapsam filtresinin unutulabileceği
 * yeni bir yer açardı. Bunun yerine çözüm TEK BİR yerde, auth katmanında
 * yapılıyor: jwt callback `googleId` → `AgencyMember` → `agencyId` zincirini
 * kurup token'a yine düz bir `agencyId` koyuyor. Aşağı akıştaki hiçbir şey
 * değişmiyor, IDOR koruması aynen duruyor.
 */
model AgencyMember {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  /**
   * Kimliğin ta kendisi: Google `providerAccountId` (ya da test girişinde
   * `test:` önekli e-posta — bkz. auth.ts). GLOBAL `@unique`, ajans kapsamlı
   * değil: bir kişi aynı anda yalnızca TEK bir ajansa ait olabilir. Bu kısıt
   * bilinçli — çoklu üyelik `session.agencyId`'yi tek değerli olmaktan
   * çıkarır, "hangi ajanstasın" sorusunu bir ajans-değiştirici arayüzüne
   * bağlar ve yukarıda korumaya çalıştığımız sözleşmeyi bozardı.
   */
  googleId String @unique

  /** Giriş yapılan Google hesabının e-postası; davet eşleştirmesi buna bakar. */
  email     String
  name      String?
  role      AgencyRole @default(member)
  createdAt DateTime   @default(now())

  @@index([agencyId])
  // Davet kabulü ve "bu e-posta zaten ekipte mi" kontrolü e-postadan gidiyor.
  @@index([email])
}

/**
 * F6 — bekleyen ekip daveti.
 *
 * ─── Token ne işe YARIYOR, ne işe YARAMIYOR ────────────────────────────────
 * Token yalnızca davet mailindeki linkin adresidir: `/invite/<token>` sayfası
 * "seni X ajansı davet etti, Google ile giriş yap" bağlamını gösterebilsin
 * diye. Katılımı BAŞLATMAZ ve tek başına YETMEZ.
 *
 * Asıl kabul koşulu e-posta eşleşmesi: giriş yapılan Google hesabının
 * e-postası davetin `email` alanıyla birebir (küçük harfe indirgenerek) aynı
 * olmalı. Kabul, token'dan değil e-postadan sorgulanır (bkz. membership.ts).
 * Sebebi bir güvenlik sınırı: token tabanlı kabulde linki ele geçiren HERKES
 * — mail kutusuna erişimi olmasa bile — ajansa girerdi. E-posta tabanlı
 * kabulde çalınan link hiçbir şeye yaramaz; kabul edebilecek tek kişi, davetin
 * gittiği kutunun sahibi.
 */
model AgencyInvite {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id])

  /** DAİMA küçük harfe indirgenerek saklanır — eşleştirme buna güveniyor. */
  email String
  role  AgencyRole @default(member)

  /** `randomUUID` (122 bit) — bkz. tokens.ts, onay linkiyle aynı gerekçe. */
  token String @unique

  expiresAt DateTime
  /** Dolu = kullanılmış. Aynı davet ikinci kez kabul edilemez. */
  acceptedAt DateTime?
  /** Kimin davet ettiği; panelde "kim çağırdı" sorusunun cevabı. */
  invitedByEmail String?
  createdAt      DateTime @default(now())

  @@index([agencyId])
  @@index([email])
}

model Client {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  name      String
  email     String
  createdAt DateTime @default(now())
  posts     Post[]

  // Instagram yayını (opt-in): boş bırakılan müşterilerde onay hiçbir şey
  // yayınlamaz, sadece durumu `approved` yapar — mevcut davranış korunur.
  instagramUserId      String? // IG professional account id
  instagramAccessToken String? // long-lived token (60 gün)
  instagramTokenExpiry DateTime?

  @@index([agencyId])
}

enum PostStatus {
  draft
  pending
  approved
  rejected
}

enum PublishStatus {
  idle // yayın hedefi yok ya da henüz sıra gelmedi
  publishing // devam ediyor (çift yayın kilidi)
  published
  failed
  skipped // müşteride Instagram bağlı değil
  // Aynı `externalRef`'e sahip kardeş post HÂLÂ Instagram'da duruyordu; yayın
  // bilinçli olarak atlandı. `failed` DEĞİL: failed "tekrar dene" yolunu açar,
  // burada tekrar denemek tam da engellemek istediğimiz şeyi yapar.
  duplicate
  // F8 — zamanlanmış yayın: post onaylandı ama `publishAt` gelecekte, yayın
  // `publish-scheduled` cron'una bırakıldı. `idle` KULLANILMADI çünkü panelde
  // "onaylandı + idle" zaten "yayın hiç denenmedi" (awaitingPublish) anlamına
  // geliyor — eski toplu onaylardan kalan, unutulmuş postların işareti. Aynı
  // durumu zamanlanmış bir posta da versek ajans "bu post unutulmuş" sanıp
  // paniğe kapılırdı; oysa burada her şey planlandığı gibi gidiyor.
  scheduled
}

model Post {
  id              String        @id @default(cuid())
  agencyId        String
  agency          Agency        @relation(fields: [agencyId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  caption         String
  status          PostStatus    @default(draft)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  approvalLink    ApprovalLink?
  images          PostImage[]

  // Onay ≠ yayın: `status` müşterinin kararı, `publishStatus` Instagram tarafı.
  // Bir post onaylanmış ama yayınlanmamış olabilir (skipped/failed).
  publishStatus PublishStatus @default(idle)
  igMediaId     String?
  igPermalink   String?
  publishError  String?
  publishedAt   DateTime?
  // Dış sistemin (furi) kendi tanımlayıcısı — "bu slug daha önce gönderildi mi"
  externalRef   String?

  // F8 — zamanlanmış yayın. `null` = mevcut davranış (onayda ANINDA yayınla).
  // Doluysa ve onay anında gelecekteyse yayın `publish-scheduled` cron'una
  // bırakılır; UTC olarak saklanır (bkz. validation.ts — girdi Türkiye saati
  // kabul edilip +03:00 ofsetiyle UTC'ye çevrilir, sunucu her zaman UTC'de
  // çalışır ve Türkiye 2016'dan beri DST uygulamadığı için sabit +03:00 güvenli).
  publishAt DateTime?

  // Onay e-postasının akıbeti. #31 bu bilgiyi /api/posts YANITINA koymuştu ama
  // hiçbir yerde saklamıyordu: yanıtı gören otomasyon öğreniyor, panele bakan
  // insan asla öğrenemiyordu. `null` = henüz hiç denenmedi.
  approvalEmailSent   Boolean?
  approvalEmailError  String?
  approvalEmailSentAt DateTime?

  // Hatırlatma (F3) — ikisi de TEK SEFERLİK; dolu olmaları "bu bildirim zaten
  // gitti" demek. Cron her gece koştuğu için tek koruma bu alanlar.
  /** Müşteriye "hâlâ bekliyor" hatırlatması gönderildi. */
  reminderSentAt     DateTime?
  /** Ajansa "onay linkinin süresi doldu, yenilemen gerekiyor" bildirimi gönderildi. */
  expiryNoticeSentAt DateTime?

  audits ApprovalAudit[]

  @@index([agencyId])
  @@index([clientId])
  @@index([externalRef])
  // Hatırlatma cron'u "bekleyen ve linki olan" postları tarıyor.
  @@index([status])
  // Zamanlanmış yayın cron'u "scheduled" + "zamanı geçmiş" postları tarıyor —
  // bileşik index olmadan her koşu publishStatus'a göre tam tablo taraması yapar.
  @@index([publishStatus, publishAt])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  url       String
  altText   String? // Instagram alt_text — erişilebilirlik, opsiyonel
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId])
}

model ApprovalLink {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ApprovalAudit {
  id     String @id @default(cuid())
  postId String
  // İlişki F4 ile eklendi. Öncesinde `postId` çıplak bir String'di: ne cascade
  // ediyor ne engelliyordu, yani post silinince öksüz satır kalabiliyordu
  // (post silme yolu bunu elle temizliyor). FK artık bunu şemada garanti ediyor
  // ve panelin karar geçmişini `include` ile okumasını mümkün kılıyor.
  // Migration öncesi prod'da öksüz satır olmadığı ölçüldü (8 kayıt, 0 öksüz).
  post      Post     @relation(fields: [postId], references: [id])
  action    String // "approved" | "rejected"
  ip        String
  createdAt DateTime @default(now())

  @@index([postId])
}
