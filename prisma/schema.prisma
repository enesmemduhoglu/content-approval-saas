generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migration'lar pooled (pgbouncer) bağlantı üzerinden güvenilir çalışmaz —
  // CLI komutları (migrate/db push) bu doğrudan bağlantıyı kullanır.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Agency {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  googleId   String   @unique
  logoUrl    String?
  brandColor String? // "#rrggbb" — onay sayfası ve e-postada accent olarak kullanılır
  createdAt  DateTime @default(now())
  clients    Client[]
  posts      Post[]
}

model Client {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id])
  name      String
  email     String
  createdAt DateTime @default(now())
  posts     Post[]

  // Instagram yayını (opt-in): boş bırakılan müşterilerde onay hiçbir şey
  // yayınlamaz, sadece durumu `approved` yapar — mevcut davranış korunur.
  instagramUserId      String? // IG professional account id
  instagramAccessToken String? // long-lived token (60 gün)
  instagramTokenExpiry DateTime?

  @@index([agencyId])
}

enum PostStatus {
  draft
  pending
  approved
  rejected
}

enum PublishStatus {
  idle // yayın hedefi yok ya da henüz sıra gelmedi
  publishing // devam ediyor (çift yayın kilidi)
  published
  failed
  skipped // müşteride Instagram bağlı değil
  // Aynı `externalRef`'e sahip kardeş post HÂLÂ Instagram'da duruyordu; yayın
  // bilinçli olarak atlandı. `failed` DEĞİL: failed "tekrar dene" yolunu açar,
  // burada tekrar denemek tam da engellemek istediğimiz şeyi yapar.
  duplicate
}

model Post {
  id              String        @id @default(cuid())
  agencyId        String
  agency          Agency        @relation(fields: [agencyId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  caption         String
  status          PostStatus    @default(draft)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  approvalLink    ApprovalLink?
  images          PostImage[]

  // Onay ≠ yayın: `status` müşterinin kararı, `publishStatus` Instagram tarafı.
  // Bir post onaylanmış ama yayınlanmamış olabilir (skipped/failed).
  publishStatus PublishStatus @default(idle)
  igMediaId     String?
  igPermalink   String?
  publishError  String?
  publishedAt   DateTime?
  // Dış sistemin (furi) kendi tanımlayıcısı — "bu slug daha önce gönderildi mi"
  externalRef   String?

  // Onay e-postasının akıbeti. #31 bu bilgiyi /api/posts YANITINA koymuştu ama
  // hiçbir yerde saklamıyordu: yanıtı gören otomasyon öğreniyor, panele bakan
  // insan asla öğrenemiyordu. `null` = henüz hiç denenmedi.
  approvalEmailSent   Boolean?
  approvalEmailError  String?
  approvalEmailSentAt DateTime?

  // Hatırlatma (F3) — ikisi de TEK SEFERLİK; dolu olmaları "bu bildirim zaten
  // gitti" demek. Cron her gece koştuğu için tek koruma bu alanlar.
  /** Müşteriye "hâlâ bekliyor" hatırlatması gönderildi. */
  reminderSentAt     DateTime?
  /** Ajansa "onay linkinin süresi doldu, yenilemen gerekiyor" bildirimi gönderildi. */
  expiryNoticeSentAt DateTime?

  audits ApprovalAudit[]

  @@index([agencyId])
  @@index([clientId])
  @@index([externalRef])
  // Hatırlatma cron'u "bekleyen ve linki olan" postları tarıyor.
  @@index([status])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  url       String
  altText   String? // Instagram alt_text — erişilebilirlik, opsiyonel
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId])
}

model ApprovalLink {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ApprovalAudit {
  id     String @id @default(cuid())
  postId String
  // İlişki F4 ile eklendi. Öncesinde `postId` çıplak bir String'di: ne cascade
  // ediyor ne engelliyordu, yani post silinince öksüz satır kalabiliyordu
  // (post silme yolu bunu elle temizliyor). FK artık bunu şemada garanti ediyor
  // ve panelin karar geçmişini `include` ile okumasını mümkün kılıyor.
  // Migration öncesi prod'da öksüz satır olmadığı ölçüldü (8 kayıt, 0 öksüz).
  post      Post     @relation(fields: [postId], references: [id])
  action    String // "approved" | "rejected"
  ip        String
  createdAt DateTime @default(now())

  @@index([postId])
}
