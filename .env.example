# Postgres bağlantı string'i
DATABASE_URL=postgresql://postgres:postgres@localhost:5455/content_approval

# Migration/CLI komutları için doğrudan (pooled olmayan) bağlantı.
# Yerelde DATABASE_URL ile aynı; production'da Neon'un unpooled URL'i.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5455/content_approval

# Google Cloud Console OAuth (boş bırakılırsa Google girişi devre dışı kalır)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -base64 32
AUTH_SECRET=

# Veritabanındaki üçüncü taraf sırlarını (şu an Client.instagramAccessToken)
# şifreleyen anahtar — base64 kodlanmış 32 bayt. Üret: openssl rand -base64 32
#
# PRODUCTION'DA ZORUNLU: anahtar yoksa Instagram bağlama isteği hata verir
# (sessizce düz metin yazmaz). Yerelde boş bırakılabilir — düz metne düşer ve
# yüksek sesle uyarır, böylece kurulum dış servis olmadan çalışır.
#
# ⚠ KAYBEDİLİRSE kayıtlı token'lar çözülemez ve her müşterinin Instagram
# hesabının panelden YENİDEN BAĞLANMASI gerekir. Değiştirmeden önce
# scripts/token-sifrele.mjs ile yeniden şifreleme planla.
ENCRYPTION_KEY=

# Production URL (approval linklerinde kullanılır; boşsa istek origin'i kullanılır)
APP_URL=

# Vercel Blob (boş bırakılırsa yerel geliştirmede public/uploads fallback'i devreye girer)
BLOB_READ_WRITE_TOKEN=

# Resend e-posta bildirimi (boş bırakılırsa e-posta gönderimi atlanır, akış devam eder)
RESEND_API_KEY=
EMAIL_FROM=

# Sistem uyarıları (F11) — cron çökmesi ve yayın hatası bu adrese düşer.
# Ajans/müşteri bildirimlerinden AYRI bir kutu: buraya "hattın kendisi bozuk"
# sinyali gider, tek bir postun akıbeti değil. Boş bırakılırsa uyarı hiçbir
# yere gitmez (sessizce atlanır, yalnızca sunucu loguna düşer).
ALERT_EMAIL=

# Kota tavanları (F7) — hepsi opsiyonel; tanımsızsa varsayılanlar devrede.
# Bir plan/faturalama sistemi DEĞİL, kaba bir kötüye kullanım supabı.
QUOTA_MAX_CLIENTS=          # varsayılan 50  (ajans başına müşteri)
QUOTA_MAX_POSTS=            # varsayılan 2000 (ajans başına ömür boyu post — depolamayı bağlar)
QUOTA_MAX_POSTS_PER_DAY=    # varsayılan 100  (kayan 24 saat — kaçak scripti asıl durduran tavan)

# Upstash Redis (dağıtık rate limiting) — boşsa in-memory fallback devrede.
# Vercel Marketplace Upstash KV entegrasyonu KV_REST_API_URL / KV_REST_API_TOKEN
# adlarıyla ekler; kod her iki ad setini de tanır.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Makine erişimi (furi bulut rutini): POST /api/posts'a JSON gövdeyle
# `Authorization: Bearer $FURI_API_KEY` ile gelir. Anahtar en az 32 karakter
# olmalı; hangi ajans adına yazacağı FURI_API_AGENCY_ID ile belirlenir.
# İkisi de boşsa makine erişimi tamamen kapalıdır.
FURI_API_KEY=
FURI_API_AGENCY_ID=

# Vercel cron sırrı. Günlük token yenileme işi
# (/api/cron/refresh-instagram-tokens) `Authorization: Bearer $CRON_SECRET`
# ile gelir; sır boşsa endpoint TAMAMEN kapalıdır (401) ve token'lar otomatik
# yenilenmez — dashboard'daki uyarı şeridine düşülür.
# Üret: openssl rand -base64 32
CRON_SECRET=

# Instagram token'ı env'e GİRMEZ — müşteri (Client) kaydında durur, böylece
# her müşterinin kendi hesabı olabilir ve bağlı olmayan müşterilerde onay
# hiçbir şey yayınlamaz. Yalnızca API host/sürümü buradan override edilebilir.
IG_API_HOST=
IG_API_VERSION=

# "1" ise Google OAuth'suz test girişi (Credentials provider) aktif olur.
# YALNIZCA yerel geliştirme/test için — production'da asla set etme.
ENABLE_TEST_AUTH=
